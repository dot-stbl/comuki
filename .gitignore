# agents runtime cache (rules hot-reload state, not source)
.agents/rule-mtimes.json

# Generated OpenAPI spec from Microsoft.Extensions.ApiDescription.Server.
# Lives next to the .csproj (OpenApiDocumentsDirectory=.) on `dotnet build`
# — single source of truth for any client codegen (Kubb, future TS/C# SDKs).
**/openapi-*.json

# Local credentials — copy deploy/.env.example, never commit the real one
deploy/.env

# Stray .md files sometimes written to project root by previous LLM sessions
# (leaked thinking blocks or mis-routed `write` calls). Agents never write
# these — they use .agents/STATE.md, .agents/HANDOFF.json,
# .agents/phases/*/{PLAN,CONTEXT}.md. Findings, plans, and progress belong
# under .agents/, not in the project root.
/plan.md
/context.md
/progress.md

# Dashboard — generated artifacts (rebuilt on every Storybook / Vitest / Playwright run)
# Real sources live in dashboard/src/, dashboard/e2e/, .storybook/. Commit only those.
dashboard/storybook-static/
dashboard/test-results/
dashboard/playwright-report/
dashboard/.tanstack/
dashboard/coverage/



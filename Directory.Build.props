<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Analyzer set (2026-08-31): IDE code-style + CA Security category only.
         CA off by default (AnalysisMode=None) — noisy style rules; explicit
         opt-ins live in .editorconfig. Meziantou (MA) and Roslynator (RCS) —
         REMOVED (noise). VSTHRD — surgical: 200/002/104 error, 103 none
         (see .editorconfig Async section for rationale). -->
    <AnalysisMode>None</AnalysisMode>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- XML doc generation is on: the OpenAPI document reads the /// summaries
         through the generated .xml files, so a missing doc is a missing
         description in the dashboard's generated client. CS1591 (missing XML
         comment) only fires while this is on — the two belong together. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress missing XML doc comments — added per-area as code lands. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Test project defaults — activated when IsTestProject=true -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,opencover</CoverletOutputFormat>
    <Threshold>70</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <!--
    Comuki build metadata (issue #56). Host projects opt in with
    <GenerateComukiBuildMetadata>true</GenerateComukiBuildMetadata>.

    The git commit hash flows into AssemblyInformationalVersion through
    SourceRevisionId ("1.0.0+<sha>"). Deliberately NOT SourceLink: the
    repository carries non-GitHub remotes and the embedded sha must not
    depend on which remotes happen to be configured — a plain
    `git rev-parse HEAD` (IgnoreExitCode: a treeless build just omits the
    sha) is host-agnostic. The SDK reads SourceRevisionId inside its
    GenerateAssemblyInfo target, so setting it BeforeTargets is the
    documented SourceLink-equivalent hook.

    The UTC build date (day granularity — keeps incremental rebuilds
    untouched within a day) and the build mode ride as assembly metadata
    and are read back through Comuki.Shared.Bootstrap ComukiBuildInfo.
  -->
  <Target Name="SetComukiSourceRevisionId"
          BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(GenerateComukiBuildMetadata)' == 'true' and '$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ComukiGitCommit" />
    </Exec>
    <PropertyGroup Condition="'$(ComukiGitCommit)' != ''">
      <SourceRevisionId>$(ComukiGitCommit)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(GenerateComukiBuildMetadata)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ComukiBuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ComukiBuildMode</_Parameter1>
      <_Parameter2>$(Configuration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

<Project>
  <!-- Central Package Management. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Testing packages (BE) -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- Platform packages (BE) -->
  <ItemGroup>
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <!-- KubernetesClient 17.x: latest stable of the line the k8s compute
         provider targets (18/19 exist but are unvetted here). -->
    <PackageVersion Include="KubernetesClient" Version="17.0.14" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
    <!-- Contract-first gRPC via reflection (no .proto, no protoc). Used by
         Shared.Contracts (owns the worker protocol contract), the Host
         (server) and Host.Translator (client). -->
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="Refit" Version="15.2.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="15.2.0" />
    <PackageVersion Include="Refit.Reflection" Version="15.2.0" />
  </ItemGroup>

  <!-- EF Core / persistence (Engine.Orchestration + Migrator) -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

  <!-- Chat graph (Voluta, S5): stateful agent graphs + EF Core checkpointer.
       0.3.0 pinned per README (public API frozen); local repo at
       C:\Users\bradw\source\stbl\voluta is the source of the packages. -->
  <ItemGroup>
    <PackageVersion Include="Voluta" Version="0.3.0" />
    <PackageVersion Include="Voluta.DependencyInjection" Version="0.3.0" />
    <PackageVersion Include="Voluta.Checkpoints.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <!-- OpenAPI emission (issue #29): build-time spec to artifacts/openapi.json,
       consumed by dashboard/kubb.config.ts. 10.0.12 is the latest stable
       on the .NET 10 line and pulls Microsoft.OpenApi 3.10.2 (past the
       patched 2.7.5 / 3.5.4 lines that fix GHSA-v5pm-xwqc-g5wc
       / CVE-2026-49451). The <NoWarn>NU1903</NoWarn> on Comuki.Host.csproj
       is dropped in lockstep with the version bump. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
  </ItemGroup>

  <!-- Caching abstractions (issue #52 slice 2): IMemoryCache consumed by
       VaultSecretProvider for the per-(address,path,key) TTL. The Memory
       implementation is referenced by host composition via AddMemoryCache. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Integration testing -->
  <ItemGroup>
    <!-- 4.14.0 (not 4.12.0): 4.12.0 pulls vulnerable SSH.NET 2025.1.0
         (GHSA-q939-rpr3-3284, NU1903 -> build error); 4.14.0 references
         the patched SSH.NET 2026.0.0. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- Base Testcontainers package — used by the Vault integration
         fixture (issue #52 slice 2) to spin the official
         hashicorp/vault:1.15 image via GenericContainer (the first-party
         Testcontainers.HashicorpVault module is not on NuGet). The base
         package is the same line as the specialized PostgreSql / Minio
         modules above. -->
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <!-- Realtime (issue #7): .NET client the integration suite connects
         to the runs hub with. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <!-- In-memory test server for WebApplication.GetTestClient() (issue #17 fixture):
         no host, no port — runs the request pipeline through TestHost. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <!-- Identity module -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <!-- Manual OIDC code-flow: discovery-doc retriever + JWT validation,
         aligned with the framework's transitive Microsoft.IdentityModel.* set. -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
  </ItemGroup>

  <!-- Host.Brain agent loop (S5): MEAI over any OpenAI-compatible endpoint
       (z.ai and friends; Anthropic models via the provider's OpenAI-compat
       surface). Versions: the matched 10.9.0 MEAI pair; OpenAI pinned to
       2.12.0 — Microsoft.Extensions.AI.OpenAI 10.9.0 constrains it to
       [2.12.0, 2.13.0). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="15.0.240" />
  </ItemGroup>

  <!-- OpenTelemetry (S8): business metrics + spans exported over OTLP to
       VictoriaMetrics (deploy/docker-compose.yml, OTLP gRPC :8431).
       Versions aligned with the console.x sdk telemetry module. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <!-- Sentry (S15 / sentry): scheduler fire side-channel. The SDK is
         referenced from the Scheduler.Infrastructure observer only —
         the SDK is a private transport detail of that observer, the
         rest of the host does not know it exists. 6.10.0 is the latest
         stable that targets net10.0 without bringing an extra TFM. -->
    <PackageVersion Include="Sentry" Version="6.10.0" />
  </ItemGroup>

  <!-- Analyzers: IDE code-style + CA Security only (see .editorconfig);
       Meziantou / Roslynator removed 2026-08-31; VSTHRD surgical (200/002/104). -->
  <ItemGroup>
  </ItemGroup>

  <!-- Artifacts module (issue #28): MinIO client SDK + Testcontainers
       fixture for the integration suite. -->
  <ItemGroup>
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
  </ItemGroup>

  <!-- Proxy module (issue #8 / S9 T9.6): YARP reverse proxy with the
       built-in Microsoft.AspNetCore.Authentication scheme for virtual-key
       auth. YARP 2.3.x targets net8.0+/net10.0 — pinned conservatively to
       keep transitive deps inside our .NET 10 / Microsoft.Extensions.* 10.0.11
       envelope. -->
  <ItemGroup>
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- Secret-resolution subsystem — issue #52, slice 2 (Vault provider).
       VaultSharp 1.17.5.1 is Apache-2.0 (permissive; AGPL/GPL are
       banned per project licensing rules). K/V v2 engine access lives
       in the VaultSecretProvider (platform/src/shared/Comuki.Shared.Kernel/Secrets).
       Testcontainers for Vault uses the GenericContainer + the official
       hashicorp/vault image (Testcontainers does not ship a first-party
       HashicorpVault module at the time of this slice — only the
       LowkeyVault mock module is published). -->
  <ItemGroup>
    <PackageVersion Include="VaultSharp" Version="1.17.5.1" />
  </ItemGroup>
</Project>

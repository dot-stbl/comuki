{
  "name": "@dot-stbl/comuki",
  "version": "0.2.0",
  "description": "Comuki CLI — terminal client for the agent orchestration platform",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dot-stbl/comuki.git"
  },
  "keywords": ["cli", "agent", "orchestration", "ai", "terminal"],
  "license": "MIT",
  "type": "module",
  "overrides": {
    "ajv-draft-04": {
      "ajv": "^8.5.0"
    }
  },
  "bin": {
    "comuki": "./bin/comuki.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "bun test",
    "start": "bun bin/comuki.ts",
    "build": "bun scripts/build.ts",
    "generate:contracts": "dotnet build ../comuki.slnx -c Debug && bunx @kubb/cli@4.39.2 generate && dotnet run --project ../tools/Comuki.Codegen.Realtime -c Debug -- --out src/contracts/_generated/realtime.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@opentui/core": "0.5.11",
    "@opentui/keymap": "0.5.11",
    "clipboardy": "^4.0.0",
    "i18next": "23.16.8",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@kubb/cli": "4.39.2",
    "@kubb/core": "4.39.2",
    "@kubb/plugin-oas": "4.39.2",
    "@kubb/plugin-ts": "4.39.2",
    "@types/bun": "^1.4.2",
    "@types/ink-testing-library": "^1.0.4",
    "@types/react": "^18.3.12",
    "@types/yargs": "^17.0.33",
    "ajv": "^8.5.0",
    "eslint": "^9",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}

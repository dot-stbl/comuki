{
  "required": [
    "since",
    "windowDays",
    "windowUsdMicros",
    "allTimeUsdMicros",
    "byProject",
    "byDay"
  ],
  "type": "object",
  "properties": {
    "since": {
      "type": "string",
      "description": "Inclusive window start (UTC instant).",
      "format": "date-time"
    },
    "windowDays": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Window length in days.",
      "format": "int32"
    },
    "windowUsdMicros": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Window spend across every project.",
      "format": "int64"
    },
    "allTimeUsdMicros": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "All-time spend across every project.",
      "format": "int64"
    },
    "byProject": {
      "type": "array",
      "items": {
        "required": ["projectId", "costUsdMicros", "runs"],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Project the spend is attributed to.",
            "format": "uuid"
          },
          "costUsdMicros": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Window spend in USD micros.",
            "format": "int64"
          },
          "runs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Distinct runs the window's events name.",
            "format": "int32"
          }
        },
        "description": "Wire row of one project's slice.",
        "x-readme-ref-name": "ProjectCostSliceView"
      },
      "description": "Per-project window slices, greatest spend first."
    },
    "byDay": {
      "type": "array",
      "items": {
        "required": ["date", "costUsdMicros"],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The UTC day (ISO date).",
            "format": "date"
          },
          "costUsdMicros": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Day spend in USD micros.",
            "format": "int64"
          }
        },
        "description": "Wire row of one UTC day of the series.",
        "x-readme-ref-name": "DayCostSliceView"
      },
      "description": "Per-UTC-day window spend, oldest day first (sparse)."
    }
  },
  "description": "Platform-wide cost rollup for `GET /api/v1/costs`. Money fields are\r\nUSD micros (1 USD = 1_000_000) — same unit as the per-project view.",
  "x-readme-ref-name": "PlatformCostsView"
}

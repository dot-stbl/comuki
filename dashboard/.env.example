# Three ways to run the dashboard, all mock-first by default.
#
# 1. `bun run dev` — no --mode flag, loads `.env.local` (gitignored). The
#    shipped default is mock-first (VITE_USE_MOCK=true, VITE_API_BASE_URL=);
#    touch `.env.local` to switch a personal copy.
# 2. `bun run dev:mock` — `vite --mode mock`, loads `.env.mock`. Equivalent
#    to (1) but explicit and committed: a reviewer running the project fresh
#    gets the same answer the tests do.
# 3. `bun run dev:real` — `vite --mode real`, loads `.env.real`. The host
#    must be running on VITE_API_BASE_URL (default http://localhost:17173,
#    see .agents/rules/process/ports.md). kubb-generated hooks hit it; mock
#    stores short-circuit off.
#
# Mock mode ignores everything below VITE_USE_MOCK. Real mode refuses an
# empty VITE_API_BASE_URL — the kubb-client transport throws on first call
# (`[kubb-client] VITE_API_BASE_URL is not set.`). Pick (1) or (2) for
# screens-only work; pick (3) when the API contract is the subject.
#
# `bun run dev` fires the `predev` hook first (audit:fe + dotnet build +
# kubb generate). Useful when the contract changed; skip it with
# `bun run dev:mock` for fast seed-only iteration once the client is fresh.

# ----------------------------------------------------------------------------
# Mode — the two knobs the dashboard reads on every render. The values below
# are the mock-first defaults; switch VITE_USE_MOCK to "false" and set
# VITE_API_BASE_URL to talk to a real host. See `.env.mock` / `.env.real` for
# the canonical pairs behind `bun run dev:mock` / `bun run dev:real`.
# ----------------------------------------------------------------------------

# When true, domain hooks serve shared mock seeds instead of live API.
# Defaults to true when unset or empty: a fresh checkout, a test run, and
# `bun run dev` all want seed data so screens render without the host.
# Real mode is opt-in — see VITE_API_BASE_URL below.
VITE_USE_MOCK=true

# Host URL kubb-generated clients route through. The kubb-client transport
# refuses an empty value when VITE_USE_MOCK is false. In mock mode this is
# ignored — the mock gate (`useMock`) decides whether the value is read.
# When running both Vite and the host on one the dev machine, this URL must
# match the host port (not the Vite dev port 17173). See the runbook:
# .agents/docs/operations/runbook.md → "Start the host".
VITE_API_BASE_URL=

# ----------------------------------------------------------------------------
# Brand — where the platform's own source lives, the topbar's repository link.
# ----------------------------------------------------------------------------
# Defaults to this repository, so a fresh checkout needs no line at all.
# Set it to a fork's address to repoint the link, or to the empty string
# (`VITE_REPO_URL=`) to take the link out of the bar. Only http/https pass;
# anything else is read as "no link".
VITE_REPO_URL=https://github.com/dot-stbl/comuki

# ----------------------------------------------------------------------------
# Auth (real mode only)
# ----------------------------------------------------------------------------
# Real-mode OIDC: name of the provider the host is configured for (the value
# must match one of the names listed under `[auth.providers.*]` in the host's
# TOML). Unset or empty → the "Continue with …" button is hidden in real
# mode. Mock mode ignores this — the mock store's `setMockOidcProvider` is
# authoritative there.
# VITE_OIDC_PROVIDER=comuki

# Bearer token for the OpenAI / Anthropic-compatible proxy at GET /v1/models.
# The proxy authenticates by virtual-key, not by cookie, so the kubb-client
# transport (cookie-only) cannot reach it. Optional in mock mode; in real
# mode the absence makes the models page fall back to the seed instead of
# calling the proxy.
# VITE_PROXY_KEY=
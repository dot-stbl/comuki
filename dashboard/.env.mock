# Vite --mode mock — synthetic data only, no host required.
#
# Loaded by `bun run dev:mock` (`vite --mode mock`). The dashboard serves
# shared seeds from src/shared/api/mock/* and the kubb-generated hooks are
# never reached: VITE_USE_MOCK=true short-circuits the API layer in
# src/shared/config/env.ts. VITE_API_BASE_URL is intentionally empty so the
# kubb-client transport — which throws if called with an empty URL — is
# also gated off.
#
# This file is the documented counterpart to `.env.real`; if a future change
# to the mock flow needs a variable the .env.example must be edited first.
VITE_USE_MOCK=true
VITE_API_BASE_URL=
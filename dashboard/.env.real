# Vite --mode real — kubb-generated hooks hit the running host.
#
# Loaded by `bun run dev:real` (`vite --mode real`). The dashboard stops
# short-circuiting on src/shared/api/mock/* and the kubb-client transport
# routes every request to VITE_API_BASE_URL. The address below matches the
# port pool reservation in .agents/rules/process/ports.md (dashboard and
# host share :17173 on the dev bench — the SPA is served by the host in
# that workflow; when running Vite + host on the same machine, switch one
# of them to a sibling port and update this line to match).
#
# An empty VITE_API_BASE_URL with VITE_USE_MOCK=false is a hard error —
# the kubb-client transport throws on first call. Do not remove this URL.
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:17173
# Kubb debug state — generated alongside src/api, not source of truth
src/api/.kubb/

# Storybook static build (test:storybook's SUT, already eslint-ignored)
storybook-static

# test:storybook run artifacts — baselines are CI-generated, never committed
# from a dev machine or an agent session (WS16, see storybook-tests/README.md
# and .agents/rules/process/agent-runtime-safety.md). report.json/.md are
# per-run output, not source.
storybook-tests/visual-baselines
storybook-tests/diffs
storybook-tests/artifacts
storybook-tests/report.json
storybook-tests/report.md
# vitest browser-mode `--project stories` writes one PNG per failing test
# (its "Failure screenshot:" line in the harness run output) — runtime
# attachment, never checked in.
storybook-tests/__screenshots__

# ui:probe run artifacts (WS17) — screenshots/DOM/aria/axe/console + summary,
# per-run output, not source. Same reasoning as the storybook-tests entries
# above.
artifacts/ui-probe

# vitest browser-mode test attachments (analogous to the storybook-tests
# __screenshots__ above — runtime artefact, never checked in).
.vitest-attachments

# ui:probe scratch outputs beyond the canonical dir (artifacts/ui-probe-*)
# — per-run diagnostic output, rebuild cost only.
artifacts/ui-probe*

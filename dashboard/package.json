{
  "name": "dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "overrides": {
    "ajv-draft-04": {
      "ajv": "^8.5.0"
    },
    "eslint": {
      "ajv": "^6.12.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:real": "vite --mode real",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "generate-api": "dotnet build ../comuki.slnx && bunx @kubb/cli@4.39.2 generate && prettier --write \"src/shared/api/_generated/**/*.ts\"",
    "audit:fe": "bun run scripts/rule-audit.ts",
    "predev": "bun run audit:fe && bun run generate-api",
    "prebuild": "bun run audit:fe",
    "storybook": "storybook dev -p 17010 --no-open",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project stories --reporter=default",
    "test:storybook": "vitest run --project stories --reporter=default",
    "ui:probe": "bun run scripts/ui-probe.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "gen:routes": "node scripts/gen-routes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/signalr": "^10.0.11",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@kubb/cli": "4.39.2",
    "@kubb/core": "4.39.2",
    "@kubb/plugin-client": "4.39.2",
    "@kubb/plugin-oas": "4.39.2",
    "@kubb/plugin-react-query": "4.39.2",
    "@kubb/plugin-ts": "4.39.2",
    "@kubb/plugin-zod": "4.39.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/test": "^8.6.15",
    "@tanstack/router-plugin": "^1.168.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "ajv": "^8.5.0",
    "axe-playwright": "^2.2.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.6.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "@swc/core",
    "es5-ext",
    "esbuild"
  ]
}

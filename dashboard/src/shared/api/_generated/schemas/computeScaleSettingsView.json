{
  "required": [
    "workerImage",
    "profilesGitRef",
    "minIdle",
    "maxConcurrent",
    "idleTtlSeconds",
    "pollIntervalSeconds"
  ],
  "type": "object",
  "properties": {
    "workerImage": { "type": "string", "description": "Default worker image." },
    "profilesGitRef": {
      "type": "string",
      "description": "Default pinned profiles git ref."
    },
    "minIdle": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Warm-idle floor per profile.",
      "format": "int32"
    },
    "maxConcurrent": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Concurrency cap per project.",
      "format": "int32"
    },
    "idleTtlSeconds": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Idle TTL before a worker is a reaper candidate.",
      "format": "int64"
    },
    "pollIntervalSeconds": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Delay between supervisor passes.",
      "format": "int64"
    }
  },
  "description": "Scale supervisor defaults from ScaleSupervisorOptions.",
  "x-readme-ref-name": "ComputeScaleSettingsView"
}

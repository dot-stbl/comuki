{
  "required": [
    "leaseTtlSeconds",
    "reapIntervalSeconds",
    "reapGraceSeconds",
    "maxAttempts"
  ],
  "type": "object",
  "properties": {
    "leaseTtlSeconds": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Lease duration handed out on claim / extended by heartbeat.",
      "format": "int64"
    },
    "reapIntervalSeconds": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Lease reaper sweep cadence.",
      "format": "int64"
    },
    "reapGraceSeconds": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Buffer past lease expiry before the reaper acts.",
      "format": "int64"
    },
    "maxAttempts": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Claim attempts before the reaper fails a stalled item.",
      "format": "int32"
    }
  },
  "description": "Claim/lease policy from LeaseOptions.",
  "x-readme-ref-name": "LeaseSettingsView"
}

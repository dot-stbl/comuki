  "type": "object",
  "properties": {
    "versionId": { "type": "string" },
    "projectId": { "type": "string", "format": "uuid" },
    "procedureKey": { "type": "string" },
    "catalogVersion": { "type": "string" },
    "sourceRef": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "required": ["id", "kindKey", "parameters"],
        "type": "object",

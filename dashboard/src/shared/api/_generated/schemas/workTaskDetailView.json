{
  "required": [
    "id",
    "projectId",
    "title",
    "brief",
    "briefVersion",
    "status",
    "resolutionOutcome",
    "attemptOrdinal",
    "activeAttemptId",
    "visibility",
    "missionId",
    "sourceRefs",
    "createdAt",
    "updatedAt"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Strong-typed task id (UUIDv7 string form).",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "description": "Owning project id.",
      "format": "uuid"
    },
    "title": { "type": "string", "description": "Task title." },
    "brief": { "type": "string", "description": "Task brief, current." },
    "briefVersion": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Versioned brief counter; bumped on every revision.",
      "format": "int32"
    },
    "status": {
      "type": "string",
      "description": "Wire-form status (PascalCase)."
    },
    "resolutionOutcome": {
      "type": ["null", "string"],
      "description": "Wire-form outcome if Resolved; null otherwise."
    },
    "attemptOrdinal": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": ["integer", "string"],
      "description": "Current attempt ordinal; 1 before any append.",
      "format": "int32"
    },
    "activeAttemptId": {
      "type": ["null", "string"],
      "description": "Active attempt's run id; null when no attempt is in flight.",
      "format": "uuid"
    },
    "visibility": {
      "type": "string",
      "description": "Standalone | MissionAttached."
    },
    "missionId": {
      "type": ["null", "string"],
      "description": "Owning mission if MissionAttached; null otherwise.",
      "format": "uuid"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "required": ["kind", "externalId", "displayName"],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Wire-form source kind (Native | GitHub | GitLab | Jira | YandexTracker)."
          },
          "externalId": {
            "type": "string",
            "description": "Fully-qualified tracker-side identifier."
          },
          "displayName": {
            "type": ["null", "string"],
            "description": "Opaque display name; null when the tracker did not provide one."
          }
        },
        "description": "Per-source-ref wire projection.",
        "x-readme-ref-name": "WorkTaskSourceRefView"
      },
      "description": "All source refs on the Task (primary first)."
    },
    "createdAt": {
      "type": "string",
      "description": "When the Task was first admitted.",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "Last status change.",
      "format": "date-time"
    }
  },
  "description": "Per-Task detail projection — the `GET /api/v1/work/tasks/{taskId}`\nresponse shape (the umbrella's `add-work-management` design\n§\"Work API\"). Caller-facing fields only — no aggregate internals.",
  "x-readme-ref-name": "WorkTaskDetailView"
}

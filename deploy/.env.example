# Local-dev credentials for the Comuki infra stack.
# Copy to `.env` (gitignored) and edit. The defaults below are the same
# ones baked into docker-compose.yml, so an empty .env is fine — but
# you MUST override COMUKI_NEXUS_ADMIN_PASSWORD before exposing port
# 8081 outside localhost.

# Postgres — used by Comuki.Platform.Database.Runs (and later .Knowledge)
COMUKI_POSTGRES_USER=comuki
COMUKI_POSTGRES_PASSWORD=comuki_dev
COMUKI_POSTGRES_DB=comuki

# MinIO — S3-compatible, holds run artifacts (diffs, screenshots, logs).
# The host reads Artifacts:Minio:* from the COMUKI_*_MINIO_* env vars
# (see deploy/README.md). The minio-init job creates the bucket below
# and applies a 30-day non-current-version lifecycle.
COMUKI_MINIO_ROOT_USER=comuki
COMUKI_MINIO_ROOT_PASSWORD=comuki_dev

# Comma-separated bucket names the minio-init job creates on first
# boot. Default bucket = comuki-run-bundles (used by the host's
# Artifacts:Minio:Bucket setting).
COMUKI_MINIO_ARTIFACTS_BUCKET=comuki-run-bundles

# Nexus — package registry (NuGet + npm + docker). Worker pulls from here
# once we wire it in Phase 3+. Initial admin password is read once on
# first boot; after that, change it via the UI and update this var too.
COMUKI_NEXUS_ADMIN_PASSWORD=comuki_dev

# ── Phase 4 — worker image build (passed through to pi in container) ──
# Copy to .env and fill in for the headless test run in 04-01.
# ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL let the same image talk to
# Anthropic directly, or to a proxy/alternative provider (z.ai GLM,
# MiniMax — all expose Anthropic-compatible endpoints per architecture.md § 04).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Default prompt for the headless smoke test. Override per-run via
# `podman run -e PI_TEST_PROMPT=...` if you want something more substantial.
PI_TEST_PROMPT=Say hello in exactly one word

# ── Keycloak (optional profile: `podman compose --profile keycloak up -d`) ──
# Dev-only bootstrap admin of the Keycloak container itself — NOT a Comuki
# account. The realm import (deploy/keycloak/comuki-realm.json) carries the
# comuki-dashboard client and the test user (test-user@comuki.test /
# test-pass-123). Comuki-side OIDC config lives on the host, not here:
#   auth:oidc:providers:0:Name=keycloak
#   auth:oidc:providers:0:Authority=http://localhost:17026/realms/comuki
#   auth:oidc:providers:0:ClientId=comuki-dashboard
#   auth:oidc:providers:0:ClientSecretEnv=COMUKI_KEYCLOAK_CLIENT_SECRET
#   auth:oidc:providers:0:RequireHttps=false   (http dev authority)
# with COMUKI_KEYCLOAK_CLIENT_SECRET set to any non-empty value (public client).
COMUKI_KEYCLOAK_ADMIN_USER=comuki
COMUKI_KEYCLOAK_ADMIN_PASSWORD=comuki_dev

# ── Grafana (optional profile: `podman compose --profile grafana up -d`) ──
# Dashboards-as-code under deploy/grafana/. Host UI on port pool :17027.
# Datasource provisioning points at victoria-metrics on the compose network.
# Host OTLP export (optional): set Telemetry__OtlpEndpoint=http://localhost:8431
# (or Telemetry:OtlpEndpoint in appsettings) so AddComukiTelemetry wires the SDK.
COMUKI_GRAFANA_ADMIN_USER=comuki
COMUKI_GRAFANA_ADMIN_PASSWORD=comuki_dev


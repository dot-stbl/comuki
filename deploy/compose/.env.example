# Comuki self-host — environment for docker compose.
# Copy to `.env` and edit:  cp .env.example .env
#
# The defaults below are LOCALHOST-ONLY dev values. They boot a working
# stack on your machine. Before exposing anything beyond localhost:
#   - replace every password / pepper / secret with real random values
#     (`openssl rand -hex 32`),
#   - set COMUKI_ENV=Production (the host then REFUSES to start
#     on these dev defaults — ProductionSecretValidator),
#   - put TLS in front (reverse proxy).

# ── Comuki environment ───────────────────────────────────────────────
# development (default here) skips the production secret checks.
# production enforces strong peppers + bootstrap password + MinIO keys.
COMUKI_ENV=Development

# ── Postgres ─────────────────────────────────────────────────────────
COMUKI_POSTGRES_USER=comuki
COMUKI_POSTGRES_PASSWORD=comuki_dev
COMUKI_POSTGRES_DB=comuki
COMUKI_POSTGRES_PORT=5432

# ── MinIO (S3 artifacts) ─────────────────────────────────────────────
COMUKI_MINIO_ROOT_USER=comuki
COMUKI_MINIO_ROOT_PASSWORD=comuki_dev
COMUKI_MINIO_BUCKET=comuki-run-bundles
COMUKI_MINIO_PORT=9000
COMUKI_MINIO_CONSOLE_PORT=9001

# ── Host secrets ─────────────────────────────────────────────────────
# HMAC peppers: rotating invalidates stored API keys / worker tokens.
COMUKI_IDENTITY_APIKEY_PEPPER=comuki-local-apikey-pepper
COMUKI_TOKEN_PEPPER=comuki-local-token-pepper

# First operator account, seeded once at startup (idempotent). Both
# halves must be set (or both unset — then no admin is created).
COMUKI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
COMUKI_BOOTSTRAP_ADMIN_PASSWORD=comuki_dev

# ── Public URLs / ports ──────────────────────────────────────────────
# The URL the host stamps into OIDC redirects and the URL the dashboard
# bundle uses as its API base (baked at image build time — changing it
# after the first build requires `docker compose build comuki-dashboard`).
COMUKI_PUBLIC_HOST_URL=http://localhost:17173
COMUKI_DASHBOARD_PORT=17173
COMUKI_HOST_PORT=17172
COMUKI_CORS_ORIGIN=http://localhost:17173

# ── Workers (Docker compute provider) ────────────────────────────────
# Image the host spawns per work item. Defaults to the locally built
# worker image (service `worker-image`); point at a published tag to
# skip local builds.
COMUKI_WORKER_IMAGE=comuki-worker:local
# Docker network worker containers join so they can reach the host.
COMUKI_DOCKER_NETWORK=comuki-net
# GID of the `docker` group on the HOST machine — the host container
# needs it to talk to the mounted /var/run/docker.sock. Find yours:
#   stat -c '%g' /var/run/docker.sock     (Linux)
# Docker Desktop (macOS/Windows): usually works with the default.
DOCKER_GID=999

# ── Images ───────────────────────────────────────────────────────────
# Which tag of ghcr.io/dot-stbl/comuki to use. `local` builds from this
# checkout; a version tag pulls the published release instead (delete
# the `build:` blocks in docker-compose.yml to skip local builds).
COMUKI_IMAGE_TAG=local

# ── Optional: standalone brain host (profile `brain`) ────────────────
# OpenAI-compatible endpoint + key + model id for the leading model.
# COMUKI_BRAIN_MODEL_ENDPOINT=https://api.example.com/v1
# COMUKI_BRAIN_MODEL_API_KEY=
# COMUKI_BRAIN_MODEL_ID=

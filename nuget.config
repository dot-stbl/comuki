<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo-local source policy: ignore user-level sources (e.g. hybrid-sdk)
       and restore from nuget.org only. Kills NU1507 (multiple sources under
       CPM without source mapping). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Comuki.Platform.Api.Public</RootNamespace>
    <AssemblyName>Comuki.Platform.Api.Public</AssemblyName>
    <!-- Build-time OpenAPI: write the spec next to the .csproj (not to obj/).
         Per docs: OpenApiDocumentsDirectory is relative to the project file.
         Single document named 'v1', file name fixed so client codegen
         (Kubb etc.) can reference a stable path. -->
    <OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi-v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\feature\Comuki.Platform.Orchestration\Comuki.Platform.Orchestration.csproj" />
    <ProjectReference Include="..\..\..\models\Comuki.Platform.Api.Contracts\Comuki.Platform.Api.Contracts.csproj" />
    <ProjectReference Include="..\..\..\models\Comuki.Platform.Entity.Core\Comuki.Platform.Entity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- PrivateAssets=all keeps this MSBuild tooling out of the runtime output. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Routing": {
    "Rotation": {
      "UpstreamUrl": "https://api.z.ai",
      "DefaultCooldown": "01:00:00",
      "ApiKeys": [],
      "RequestBufferThresholdBytes": 1048576,
      "ExhaustionRules": [
        { "StatusCode": 429 },
        { "BodyContains": "insufficient balance" },
        { "BodyContains": "quota" }
      ]
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Comuki.Platform.Translator</RootNamespace>
    <AssemblyName>Comuki.Platform.Translator</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Comuki.Platform.Translator-142179d2-4e4f-4d6a-8ae8-4a35e2cb7357</UserSecretsId>

    <!-- AOT-deferred: regular self-contained .NET 10 worker is fine for Slice 0

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Comuki.Host.Brain</RootNamespace>
    <!-- Comuki-native binary name (issue #54): the apphost ships as
         `comuki-brain`; the project/namespace stays Comuki.Host.Brain. -->
    <AssemblyName>comuki-brain</AssemblyName>
    <!-- Comuki build metadata (issue #56): git sha + UTC build date + mode
         in the binary; surfaced by <binary> version. -->
    <GenerateComukiBuildMetadata>true</GenerateComukiBuildMetadata>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\modules\Memory\Comuki.Modules.Memory.Application\Comuki.Modules.Memory.Application.csproj" />
    <ProjectReference Include="..\..\modules\Memory\Comuki.Modules.Memory.Infrastructure\Comuki.Modules.Memory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\shared\Comuki.Shared.Bootstrap\Comuki.Shared.Bootstrap.csproj" />
    <ProjectReference Include="..\..\shared\Comuki.Shared.Contracts\Comuki.Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Comuki.Host.Brain.Unit" />
  </ItemGroup>

</Project>

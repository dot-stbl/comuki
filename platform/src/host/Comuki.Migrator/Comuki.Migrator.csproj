<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Comuki.Migrator</RootNamespace>
    <!-- Comuki-native binary name (issue #54): the apphost ships as
         `comuki-migrator`; the project/namespace stays Comuki.Migrator. -->
    <AssemblyName>comuki-migrator</AssemblyName>
    <!-- Comuki build metadata (issue #56): git sha + UTC build date + mode
         in the binary; surfaced by <binary> version. -->
    <GenerateComukiBuildMetadata>true</GenerateComukiBuildMetadata>
    <!-- 0.0.0 = unstamped local build. Release builds override via
         -p:VersionPrefix=<semver> (COMUKI_VERSION build arg, RELEASE.md). -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Comuki.Shared.Migrations owns the module-context list (and the
         advisory lock); the engine reference stays for the recreate drop
         path in Program.cs. -->
    <ProjectReference Include="..\..\engine\Comuki.Engine.Orchestration\Comuki.Engine.Orchestration.csproj" />
    <ProjectReference Include="..\..\shared\Comuki.Shared.Bootstrap\Comuki.Shared.Bootstrap.csproj" />
    <ProjectReference Include="..\..\shared\Comuki.Shared.Migrations\Comuki.Shared.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Comuki.Migrator.Unit" />
  </ItemGroup>

</Project>

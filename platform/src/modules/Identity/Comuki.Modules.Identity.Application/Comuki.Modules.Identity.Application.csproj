<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Comuki.Modules.Identity.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <!-- Wave 1 B4b: Refit replaces the deprecated
         AddHttpClient<IOidcTokenExchange, OidcTokenExchange> typed-
         client factory for the OIDC token endpoint. Discovery
         stays on a raw HttpClient — see OidcDiscoveryCache for why
         (Keycloak 26's bool-as-bool discovery fields break strict
         STJ deserialization of the framework's OpenIdConnectConfiguration).
         Refit.Reflection is required by AddRefitClient<T> for any
         interface whose [Post("")]/[Get("")] template cannot be
         inlined at source-gen time (here: tokenEndpoint is per-call,
         not a static segment); without it, runtime throws
         "This interface needs the reflection request builder". -->
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Refit.Reflection" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comuki.Modules.Identity.Domain\Comuki.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\..\shared\Comuki.Shared.Kernel\Comuki.Shared.Kernel.csproj" />
  </ItemGroup>

</Project>

    <ProjectReference Include="..\..\..\shared\Comuki.Shared.Kernel\Comuki.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\shared\Comuki.Shared.Telemetry\Comuki.Shared.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Comuki.Modules.Knowledge.Unit" />
  </ItemGroup>

</Project>

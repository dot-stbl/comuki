<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Comuki.Shared.Kernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="VaultSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Comuki.Shared.Kernel.Tests" />
    <!-- Engine + host reach the shared ADO helpers
         (AdoCommandHelpers) from their guarded-SQL sites.
         Comuki.Host.csproj overrides its AssemblyName to `comuki`
         (issue #54 — the apphost ships as `comuki`), so the grant
         targets the assembly name, not the project name. -->
    <InternalsVisibleTo Include="Comuki.Engine.Orchestration" />
    <InternalsVisibleTo Include="comuki" />
  </ItemGroup>

</Project>

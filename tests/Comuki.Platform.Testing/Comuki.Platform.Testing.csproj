<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not a test project — library for test infrastructure.
         No UseMicrosoftTestingPlatformRunner, no IsTestProject.
         Must NOT reference xunit.v3 (causes 'must be executable' error). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- References to src projects that testing infra depends on -->
    <ProjectReference Include="..\..\platform\src\application\api\Comuki.Platform.Api.Public\Comuki.Platform.Api.Public.csproj" />
  </ItemGroup>

</Project>

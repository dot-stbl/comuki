<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Comuki.Platform.Worker.Translator.Integration.TestTools.TestFakePi</RootNamespace>
    <AssemblyName>Comuki.Platform.Worker.Translator.Integration.TestTools.TestFakePi</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle the parser's fixture files into TestFakePi's bin/Fixtures/ so the
         integration test can spawn TestFakePi and have it read the canonical
         stream-json samples without per-test fixture shipping. -->
    <None Include="..\Comuki.Platform.Worker.Translator.Unit.StreamJson\Fixtures\*.json"
          Link="Fixtures\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

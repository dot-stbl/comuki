<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Comuki.EndToEnd.AgentLoop</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
    <!-- WorkerTestImage builds tests/tools/Comuki.TestFakePi/worker-test.Dockerfile
         through Testcontainers' own image builder — the same low-level
         client PostgresCollectionFixture already proves works against this
         repo's Podman DOCKER_HOST/TESTCONTAINERS_RYUK_DISABLED setup. -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Docker.DotNet.Enhanced" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reusable scenario model + loader + runner engine + report
         writer this suite is the T2a harness for. -->
    <ProjectReference Include="..\..\tools\Comuki.AgentTest.Runner\Comuki.AgentTest.Runner.csproj" />
    <!-- Comuki.Host: HostComposer/HostDatabase/ApiRoutes (internal —
         InternalsVisibleTo already grants Comuki.Host.Testing; this
         project references Comuki.Host.Testing too so it inherits the
         grant transitively — see Comuki.Host.Testing.csproj's own
         comment on the same pattern). AddWorkerRuntime/MapWorkerRuntime
         (Comuki.Host.Workers) is the worker REST+gRPC surface a real
         container's Translator claims/streams against — mapped explicitly
         by AgentLoopHost, same sequence as platform/src/host/Comuki.Host/Program.cs
         and this repo's WorkerUploadArtifactShould precedent. -->
    <ProjectReference Include="..\..\..\platform\src\host\Comuki.Host\Comuki.Host.csproj" />
    <ProjectReference Include="..\Comuki.Host.Testing\Comuki.Host.Testing.csproj" />
    <ProjectReference Include="..\..\..\platform\src\engine\Comuki.Engine.Orchestration\Comuki.Engine.Orchestration.csproj" />
    <ProjectReference Include="..\..\..\platform\src\engine\Comuki.Engine.Compute\Comuki.Engine.Compute.csproj" />
    <ProjectReference Include="..\..\..\platform\src\shared\Comuki.Shared.Contracts\Comuki.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\platform\src\shared\Comuki.Shared.Kernel\Comuki.Shared.Kernel.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Comuki.Host.Integration.Secrets</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
    <!-- Testcontainers for Hashicorp Vault: the official Testcontainers
         module (Testcontainers.HashicorpVault) is not on NuGet at the
         time of this slice — only Testcontainers.LowkeyVault (a mock
         Vault) is published. We use the base Testcontainers package
         with GenericContainer + the official hashicorp/vault:1.15
         image. -->
    <PackageReference Include="Testcontainers" />
    <!-- VaultSharp (the provider + client factory surface) comes
         transitively via Comuki.Shared.Kernel / Comuki.Host; the host
         factory is internal and reached through the
         InternalsVisibleTo grant in Comuki.Host.csproj (matches the
         other host integration projects). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\platform\src\host\Comuki.Host\Comuki.Host.csproj" />
    <ProjectReference Include="..\..\..\platform\src\shared\Comuki.Shared.Kernel\Comuki.Shared.Kernel.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Comuki.Host.Testing</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Not a test project: no [Fact]/[Theory] live here, so IsTestProject
         and UseMicrosoftTestingPlatformRunner stay unset — CI builds this
         project but never runs it (TESTING-RULES.md §5/§10). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Shouldly, for the login-response assertion in
         TestBootstrapAdmin's HttpClient extension. -->
    <PackageReference Include="Shouldly" />
    <!-- WS2 (add-agentic-test-contour): PostgresCollectionFixture
         implements xunit's IAsyncLifetime and reads TestContext.Current —
         the only reason this otherwise-not-a-test-project references
         xunit.v3. It still carries no [Fact]/[Theory], so IsTestProject /
         UseMicrosoftTestingPlatformRunner stay unset (see the note above);
         CI builds this project but never runs it as a suite. Owns the one
         shared Postgres container + Respawner every converted integration
         project's collection now reuses, instead of each Host*Server
         building its own. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Comuki.Host: HostComposer/HostDatabase (internal — see the
         InternalsVisibleTo grant added to Comuki.Host.csproj) plus every
         module Infrastructure project it references transitively.
         Comuki.Shared.Migrations owns the migrated-context list behind
         HostDatabaseMigrator; Knowledge and Memory are still referenced
         directly (Comuki.Host does not reference either — see
         SmokeHostServer's "composition gap" note). -->
    <ProjectReference Include="..\..\..\platform\src\engine\Comuki.Engine.Orchestration\Comuki.Engine.Orchestration.csproj" />
    <ProjectReference Include="..\..\..\platform\src\host\Comuki.Host\Comuki.Host.csproj" />
    <ProjectReference Include="..\..\..\platform\src\modules\Knowledge\Comuki.Modules.Knowledge.Infrastructure\Comuki.Modules.Knowledge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\platform\src\modules\Memory\Comuki.Modules.Memory.Infrastructure\Comuki.Modules.Memory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\platform\src\shared\Comuki.Shared.Migrations\Comuki.Shared.Migrations.csproj" />
  </ItemGroup>

</Project>
